rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /objave/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.avtorId == request.auth.uid;
      // Avtor lahko ureja objavo, vsak prijavljen uporabnik pa lahko spremeni le polje "vsecki".
      allow update: if request.auth != null && (
        resource.data.avtorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vsecki'])
      );
      allow delete: if request.auth != null && resource.data.avtorId == request.auth.uid;

      match /komentarji/{k} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.avtorId == request.auth.uid;
        allow delete: if request.auth != null && resource.data.avtorId == request.auth.uid;
      }
    }

    // "Bil sem tu" pri vrhovih
    match /obiski/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && id == request.auth.uid + '_' + request.resource.data.vrh;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
